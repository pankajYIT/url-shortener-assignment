{
  "name": "assignment/url-shortener",
  "type": "project",
  "description": "Company-aware URL shortener assignment built with Laravel 12",
  "require": {"php": "^8.2", "laravel/framework": "^12.0"},
  "require-dev": {"phpunit/phpunit": "^11.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
  "config": {"sort-packages": true, "optimize-autoloader": true},
  "minimum-stability": "stable", "prefer-stable": true
}
